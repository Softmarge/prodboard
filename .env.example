# ---- Database (Neon or Supabase Postgres) ----
# Pooled connection string used by the app at runtime.
# Neon: copy the "Pooled connection" string; keep ?sslmode=require and add &pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection string used only for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth ----
# A long random string used to sign session tokens. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- First admin (seeded by `npm run db:seed`) ----
# The first account. This person's organization is created and they become its admin (Lead PM).
SEED_ORG_NAME="My Organization"
SEED_ADMIN_NAME="Lead PM"
SEED_ADMIN_EMAIL="majestysafe@gmail.com"
# Set a strong password here only for seeding; it is hashed before storage and never committed.
SEED_ADMIN_PASSWORD="change-me-before-seeding"
# Set to "true" to also insert a handful of example products and tasks on seed.
SEED_EXAMPLES="true"
