// Pending Deliverables Tracker, data model
// Multi-tenant from day one: every record carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN // Lead PM, full control of the organization
  PM    // Product Manager, create/manage products and tasks
  VIEWER // read-only (e.g. CTO, stakeholders)
  TASK_OWNER // sees only the tasks they own; can update and mark them done
  REVIEWER // sees only the tasks they review (reviewer workflow)
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETE
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @unique
  teams       String[] // custom team/function names added beyond the defaults
  inviteToken String?  @unique // shareable token; anyone with the link joins this org
  createdAt   DateTime @default(now())

  users         User[]
  products      Product[]
  tasks         Task[]
  activities    Activity[]
  inviteLinks   InviteLink[]
  productGroups ProductGroup[]
  featureAlerts FeatureAlert[]
}

// A targeted, dismissible in-app announcement for rolling out a feature to the
// people it matters to (by role). Each recipient dismisses it for themselves.
model FeatureAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String
  linkUrl        String?
  linkLabel      String?
  audience       String[] // any of: all | pm | owner | reviewer | viewer
  active         Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())

  dismissals FeatureAlertDismissal[]

  @@index([organizationId])
}

model FeatureAlertDismissal {
  id        String       @id @default(cuid())
  alertId   String
  alert     FeatureAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime     @default(now())

  @@unique([alertId, userId])
  @@index([userId])
}

// A personal, named set of products a user wants to view together (e.g. a
// weekly standup). Everything scopes to the active group when one is selected.
model ProductGroup {
  id             String       @id @default(cuid())
  name           String
  productIds     String[] // member product ids (same organization)
  userId         String // owner; groups are personal
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model InviteLink {
  id             String       @id @default(cuid())
  token          String       @unique // shareable token
  role           Role? // PM or VIEWER (enforced in the API); null = invitee chooses
  firstName      String? // optional prefill for the signup form
  surname        String? // optional prefill for the signup form
  usedAt         DateTime? // set when a named link is consumed; named links are single-use
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String // display name (the first name); unique within the org
  firstName      String?
  surname        String?
  passwordHash   String
  role           Role         @default(PM)
  // Additive capabilities a Lead PM can grant on top of the primary role, so a
  // user can hold more than one role at once. ADMIN implies all of them.
  viewAll        Boolean      @default(false) // also a Viewer (org read-only)
  capPm          Boolean      @default(false) // also a PM (can manage products/tasks)
  capOwner       Boolean      @default(false) // also a Task owner
  capReviewer    Boolean      @default(false) // also a Reviewer
  activeGroupId  String? // last selected product group; null = Main (all products)
  lastSeenAt     DateTime? // updated by a heartbeat; drives online presence and last seen
  hlName1        String? // personal highlight preset 1 name
  hlColor1       String? // personal highlight preset 1 color (hex)
  hlName2        String? // personal highlight preset 2 name
  hlColor2       String? // personal highlight preset 2 color (hex)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  ownerAliases String[] @default([]) // owner labels on tasks that are this person (e.g. "Richard" for Richie)

  resets      PasswordReset[]
  nameChanges PendingNameChange[]
  groups        ProductGroup[]
  highlights    TaskHighlight[]
  ownedTasks    Task[]              @relation("OwnedTasks")
  reviewedTasks Task[]              @relation("ReviewedTasks")
  notifications Notification[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PendingNameChange {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newName   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String // display name (first name)
  firstName    String?
  surname      String?
  passwordHash String
  organization String?
  role         String?
  inviteToken  String?
  codeHash     String // sha-256 of the 4-digit code
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha-256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Product {
  id             String       @id @default(cuid())
  name           String // brand/base name, e.g. "Winbundle"
  pm             String? // managing PM (display name)
  type           String? // single platform type, e.g. "Mobile App"; display name = name + " " + type
  decommissioned Boolean      @default(false) // retired, hidden from default views; never hard-deleted
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      String?
  createdAt      DateTime     @default(now())

  tasks Task[]

  @@index([organizationId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  context        String? // optional intro/description for stakeholders
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  team           String
  owner          String // person OR team/function (free text label as typed)
  ownerUserId    String? // resolved account once linked; drives My Tasks and owner actions
  ownerUser      User?        @relation("OwnedTasks", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerDoneAt    DateTime? // owner marked their part done; awaiting PM confirmation
  ownerDoneBy    String? // display name of the owner who marked done
  reviewer       String? // optional second reviewer (free text label as typed)
  reviewerUserId String? // resolved reviewer account; drives My Reviews and reviewer actions
  reviewerUser   User?        @relation("ReviewedTasks", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  priority       Int          @default(2) // 1 = most important, 3 = least
  status         Status       @default(IN_PROGRESS)
  startDate      DateTime?
  dueDate        DateTime? // optional while Not started; required once active
  serviceRequest String?
  blocker        String?
  createdBy      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities Activity[]
  highlights TaskHighlight[]

  @@index([organizationId])
  @@index([productId])
}

// An in-app notification for one recipient (owner-done, confirm, send-back, assigned).
model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  type           String // owner_done | confirm | sendback | assigned
  taskId         String?
  text           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// A private, per-user highlight color on a task. Only the owner sees it.
model TaskHighlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  color     String // hex color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, taskId])
  @@index([userId])
}

model Activity {
  id             String       @id @default(cuid())
  type           String // created | status | note | product
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskTitle      String?
  fromStatus     String?
  toStatus       String?
  content        String?
  author         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ts             DateTime     @default(now())

  @@index([organizationId])
  @@index([taskId])
  @@index([ts])
}
